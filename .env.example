# ==============================================================================
# API FAILURE TWIN — ENVIRONMENT CONFIGURATION TEMPLATE
# Safe synthetic simulation environment (No real production API keys required)
# ==============================================================================

# Backend Configuration
APP_ENV=simulation
API_HOST=0.0.0.0
API_PORT=8000

# Frontend Configuration
# In development with Vite proxy, '/api' is used by default.
# For production or decoupled deployments, specify the backend endpoint:
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: Server-side Gemini API key (Only if future natural language synthesis is enabled)
# NEVER EXPOSE ON FRONTEND OR COMMIT TO REPOSITORY
# GEMINI_API_KEY=
